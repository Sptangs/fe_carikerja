# Salin file ini menjadi .env.development.local untuk konfigurasi lokal.
# File .env, .env.local, dan varian .env.* lainnya TIDAK boleh di-commit.
#
# Hanya variabel berawalan VITE_ yang diekspos ke bundle browser.
# JANGAN pernah menaruh kredensial backend (APP_KEY, DB_PASSWORD, SMTP,
# token layanan pihak ketiga, dsb.) di environment frontend.

VITE_API_BASE_URL=http://127.0.0.1:8000
